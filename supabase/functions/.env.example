# Generate these values in the production secret manager; never expose them to Vite/browser code.
TRACKING_HASH_SECRET=INVALID
INTERNAL_WORKER_SECRET=INVALID

# Exact real HTTPS funnel origins, comma separated.
BROWSER_EVENT_ALLOWED_ORIGINS=https://REPLACE_WITH_REAL_FUNNEL_ORIGIN
CHECKOUT_ALLOWED_REDIRECT_ORIGINS=https://REPLACE_WITH_REAL_FUNNEL_ORIGIN

# Exact production dashboard origin used by authenticated Admin functions.
ADMIN_ALLOWED_ORIGINS=https://partners.REPLACE_WITH_CONFIRMED_DOMAIN

# Each server-only key is bound to exactly one production product and funnel.
# Rotate by temporarily adding a second key with the same product/funnel scope.
FUNNEL_HMAC_BINDINGS={"REPLACE_KEY_ID":{"secret":"INVALID","product_id":"11111111-1111-4111-8111-111111111111","funnel_id":"22222222-2222-4222-8222-222222222222"}}
FUNNEL_EVENT_ALLOWED_NAMES=REPLACE_WITH_APPROVED_SERVER_EVENT_NAMES
FUNNEL_EVENT_ALLOWED_PROPERTIES=REPLACE_WITH_APPROVED_PROPERTY_NAMES

# Live Stripe values only. Configure after the Stripe account and endpoint exist.
# API compatibility is intentionally not an environment variable: source code
# pins direct calls and the webhook endpoint to 2026-02-25.clover so they cannot
# drift independently. Each direct request also has an eight-second abort limit.
STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
