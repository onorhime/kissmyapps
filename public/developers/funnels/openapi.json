    "/checkout-session": {
      "servers": [
        {
          "url": "https://mmyruzjemjecqyivhrgr.supabase.co/functions/v1"
        }
      ],
      "post": {
        "operationId": "createServerCheckout",
        "summary": "createServerCheckout",
        "description": "Server-authenticated checkout; UI mode is adapter-owned. Email is prefill only. Retries bind immutable mode, keyed email fingerprint and no-charge guard. Existing open sessions are retrieved, not recreated.",
        "security": [
          {
            "KeyId": [],
            "Timestamp": [],
            "Nonce": [],
            "Signature": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "click_id",
                  "offer_key",
                  "offer_version"
                ],
                "properties": {
                  "click_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{16,128}$"
                  },
                  "offer_key": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "offer_version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 999999999
                  },
                  "require_no_payment": {
                    "type": "boolean",
                    "const": true,
                    "description": "Server-only guard. Uses the product-scoped 100%-off forever promotion; missing discount or nonzero Stripe total fails closed."
                  },
                  "ui_mode": {
                    "type": "string",
                    "enum": [
                      "hosted",
                      "embedded"
                    ],
                    "default": "hosted"
                  },
                  "customer_email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254,
                    "description": "Stripe billing prefill only, not identity or attribution evidence. Required by the BC Learn embedded adapter."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/HostedCheckout"
                    },
                    {
                      "$ref": "#/components/schemas/EdgeEmbeddedCheckout"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid HMAC",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin, scope or receipt rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Context unavailable",
            "content": {
