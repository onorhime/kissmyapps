{
  "openapi": "3.1.0",
  "info": {
    "title": "KissMyApps Funnel Contract",
    "version": "1.3.0",
    "description": "Embedded or hosted checkout, billing email prefill, receipt-bound direct Stripe confirmation, and independent webhook normalization. BC Learn has no product app/backend yet. App access and purchase-claim APIs are not implemented or included in v1.3; see funnel-api.md section 7.1 for the future developer integration requirements."
  },
  "servers": [
    {
      "url": "https://bc-learn-partner-funnel.vercel.app"
    }
  ],
  "paths": {
    "/api/waitlist": {
      "post": {
        "operationId": "saveBcLearnEarlyAccessEmail",
        "summary": "Save the BC Learn email step before showing the paywall",
        "description": "Existing BC Learn lead-capture service, separate from the partner financial API. Saves to the existing Firestore waitlist and may send its configured welcome email. Does not create a partner account, payment, commission or entitlement. Only an HTTP-success {ok:true} response advances the copied funnel to its paywall. Email is excluded from partner analytics; the checkout step separately forwards billing email to Stripe. Existing endpoint abuse controls require production review.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "session_id": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "answers": {
                    "type": "object",
                    "properties": {
                      "speaking_goal": {
                        "type": "string",
                        "enum": [
                          "work_career",
                          "everyday_conversations",
                          "travel_living_abroad",
                          "study_interviews",
                          "confidence_fluency"
                        ]
                      },
                      "speaking_barrier": {
                        "type": "string",
                        "enum": [
                          "freeze",
                          "fear_mistakes",
                          "no_partner",
                          "pronunciation",
                          "fast_english"
                        ]
                      },
                      "preferred_format": {
                        "type": "string",
                        "enum": [
                          "live_groups",
                          "one_to_one",
                          "ai_guided",
                          "mixed"
                        ]
                      }
                    }
                  },
                  "context": {
                    "type": "object",
                    "properties": {
                      "timezone": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "locale": {
                        "type": "string",
                        "maxLength": 32
                      },
                      "acquisition_source": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "campaign": {
                        "type": "string",
                        "maxLength": 120
                      },
                      "keyword": {
                        "type": "string",
                        "maxLength": 120
                      },
                      "referrer": {
                        "type": "string",
                        "maxLength": 200
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email saved. The UI may show the paywall, not a payment-success state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "created"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "created": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Email invalid. Remain on email entry."
          },
          "502": {
            "description": "Email could not be saved. Remain on email entry and allow retry."
          },
          "503": {
            "description": "Existing waitlist store is not configured. Do not advance to checkout."
          }
        }
      }
    },
