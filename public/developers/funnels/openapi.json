                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Offer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "version",
          "name",
          "currency",
          "unit_amount_minor",
          "billing_mode",
          "interval",
          "interval_count"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "unit_amount_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999
          },
          "billing_mode": {
            "const": "subscription"
          },
          "interval": {
            "enum": [
              "day",
              "week",
              "month",
              "year"
            ]
          },
          "interval_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          }
        }
      },
      "Checkout": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/HostedCheckout"
          },
          {
            "$ref": "#/components/schemas/EmbeddedCheckout"
          }
        ]
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "request_id"
        ],
        "properties": {
          "status": {
            "enum": [
              "pending",
              "paid",
              "no_payment_required",
              "expired",
              "failed"
            ]
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "OfferInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "click_id"
        ],
        "properties": {
          "click_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          }
        }
      },
      "CheckoutInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "click_id",
          "offer_key"
        ],
        "properties": {
          "click_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          },
          "offer_key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "customer_email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Stripe billing prefill only, not identity or attribution evidence. Required by the BC Learn embedded adapter."
          }
        }
      },
      "StatusInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^cs_live_[A-Za-z0-9_]{8,160}$"
          }
        }
      },
      "ContextInput": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "click_id",
              "offer_key"
            ],
            "properties": {
              "action": {
                "const": "offer"
              },
              "click_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{16,128}$"
              },
              "offer_key": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "click_id",
              "attempt_id",
              "session_id"
            ],
            "properties": {
              "action": {
                "const": "status"
              },
              "click_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{16,128}$"
              },
              "attempt_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{32,128}$"
              },
              "session_id": {
                "type": "string",
                "pattern": "^cs_live_[A-Za-z0-9_]{8,160}$"
              }
            }
          }
        ]
      },
      "BrowserEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_name",
          "click_id",
          "occurred_at",
          "properties"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_name": {
            "enum": [
              "landing_viewed",
              "funnel_started",
              "payment_viewed",
              "app_store_clicked"
            ]
          },
          "click_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "properties": {
            "type": "object",
            "description": "Allowlisted non-identifying properties only; see browser-attribution.ts. Never include full URLs or email."
          }
        }
      },
      "EventReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accepted",
          "event_id",
          "duplicate",
          "request_id"
        ],
        "properties": {
          "accepted": {
            "const": true
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "duplicate": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "TrustedEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_name",
          "click_id",
          "occurred_at",
          "properties"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_name": {
            "type": "string",
            "description": "Must be in FUNNEL_EVENT_ALLOWED_NAMES; not payment truth.",
            "pattern": "^[a-z][a-z0-9_.-]{0,99}$"
          },
          "click_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "properties": {
            "type": "object",
            "description": "Allowlisted non-identifying properties only; see browser-attribution.ts. Never include full URLs or email."
          }
        }
      },
      "HostedCheckout": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkout_url",
          "attempt_id",
          "expires_at",
          "request_id"
        ],
        "properties": {
          "checkout_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://checkout\\.stripe\\.com/"
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{32,128}$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "EmbeddedCheckout": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ui_mode",
          "checkout_url",
          "client_secret",
          "session_id",
          "publishable_key",
          "attempt_id",
          "expires_at",
          "request_id"
        ],
        "properties": {
          "checkout_url": {
            "type": "null"
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{32,128}$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string"
          },
          "ui_mode": {
            "const": "embedded"
          },
          "client_secret": {
            "type": "string",
            "maxLength": 512,
            "description": "Ephemeral Stripe client secret. Component memory only; never store or log."
          },
          "session_id": {
            "type": "string",
            "pattern": "^cs_live_[A-Za-z0-9_]{8,160}$"
          },
          "publishable_key": {
            "type": "string",
            "pattern": "^pk_live_[A-Za-z0-9_]{16,256}$"
          }
        }
      },
      "EdgeEmbeddedCheckout": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ui_mode",
          "checkout_url",
          "client_secret",
          "session_id",
          "attempt_id",
          "expires_at",
          "request_id"
        ],
        "properties": {
          "checkout_url": {
            "type": "null"
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{32,128}$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string"
          },
          "ui_mode": {
            "const": "embedded"
          },
          "client_secret": {
            "type": "string",
            "maxLength": 512,
            "description": "Ephemeral Stripe client secret. Component memory only; never store or log."
          },
          "session_id": {
            "type": "string",
            "pattern": "^cs_live_[A-Za-z0-9_]{8,160}$"
          }
        }
      }
    },
    "securitySchemes": {
      "SameOrigin": {
        "type": "apiKey",
        "in": "header",
        "name": "Origin",
        "description": "Exact configured funnel origin; not a secret. Browser-events uses the backend origin allowlist."
      },
      "QuoteCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "kma_checkout_quote",
        "description": "HttpOnly signed claim; do not fabricate."
      },
      "ReceiptCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "kma_checkout_receipt",
        "description": "HttpOnly signed receipt; do not fabricate."
      },
      "KeyId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-kma-key-id",
        "description": "HMAC-SHA256 over timestamp.nonce.exact_body, with a per-product/funnel secret; timestamp tolerance 300s."
      },
      "Timestamp": {
        "type": "apiKey",
        "in": "header",
        "name": "x-kma-timestamp",
        "description": "HMAC-SHA256 over timestamp.nonce.exact_body, with a per-product/funnel secret; timestamp tolerance 300s."
      },
      "Nonce": {
        "type": "apiKey",
        "in": "header",
        "name": "x-kma-nonce",
        "description": "HMAC-SHA256 over timestamp.nonce.exact_body, with a per-product/funnel secret; timestamp tolerance 300s."
      },
      "Signature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-kma-signature",
        "description": "HMAC-SHA256 over timestamp.nonce.exact_body, with a per-product/funnel secret; timestamp tolerance 300s."
      }
    }
  }
}
