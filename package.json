{
  "name": "affiliate-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/strip-production-preview-artifacts.mjs",
    "lint": "oxlint",
    "format": "prettier --write src integrations/funnel deploy/tracking-gateway index.html demo-funnel.html",
    "format:check": "prettier --check src integrations/funnel deploy/tracking-gateway index.html demo-funnel.html",
    "funnel:check": "tsc -p integrations/funnel/tsconfig.json && oxlint integrations/funnel --deny-warnings",
    "statements:generate": "node --experimental-strip-types scripts/generate-preview-statements.mjs",
    "test": "vitest run src integrations --maxWorkers=1 && node --experimental-vm-modules --test scripts/*.test.mjs",
    "test:watch": "vitest src integrations",
    "test:edge": "deno fmt --check --config supabase/functions/deno.json supabase/functions && deno lint --config supabase/functions/deno.json supabase/functions && deno check --config supabase/functions/deno.json supabase/functions/*/index.ts && deno test --config supabase/functions/deno.json --allow-env supabase/functions",
    "test:db:audit": "node scripts/check-audit-migrations.mjs",
    "test:funnel:ui": "vitest run --config integrations/funnel/ui-check/vitest.config.ts",
    "validate:all": "pnpm validate && pnpm test:edge",
    "validate": "pnpm format:check && pnpm lint && pnpm funnel:check && pnpm test && pnpm build",
    "preview": "vite preview",
    "preview:metrics": "node scripts/funnel-metrics-local.mjs",
    "test:managed:crossapp": "node --conditions=react-server scripts/test-managed-checkout-crossapp.mjs"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@stripe/connect-js": "^3.4.6",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^1.34.0",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "jsqr": "^1.4.0",
    "oxlint": "^1.79.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "supabase": "2.115.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
